{
  "datasets": [
    {
      "name": "a1d9e50d",
      "displayName": "top_10_products",
      "queryLines": [
        "SELECT\r\n",
        "    product_id,\r\n",
        "    product_name,\r\n",
        "    category,\r\n",
        "    total_revenue,\r\n",
        "    total_orders\r\n",
        "FROM workspace.gold.sales_by_product\r\n",
        "ORDER BY total_revenue DESC, product_id ASC\r\n",
        "LIMIT 10;"
      ]
    },
    {
      "name": "60e0bea2",
      "displayName": "customer_revenue_distribution",
      "queryLines": [
        "SELECT\r\n",
        "    customer_id,\r\n",
        "    customer_segment,\r\n",
        "    lifetime_value_actual\r\n",
        "FROM workspace.gold.revenue_by_customer;"
      ]
    },
    {
      "name": "efc5fc5b",
      "displayName": "customer_segmentation",
      "queryLines": [
        "SELECT\r\n",
        "    segment_type,\r\n",
        "    customer_count\r\n",
        "FROM workspace.gold.customer_segmentation;"
      ]
    }
  ],
